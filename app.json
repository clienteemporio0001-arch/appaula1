{
  "expo": {
    "name": "ASTRO CALC",
    "slug": "astro-calc",
    "scheme": "astrocalc",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070D",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mmsolucoes.astrocalc"
    },
    "android": {
      "package": "com.mmsolucoes.astrocalc",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070D"
      }
    },
    "web": {
      "name": "ASTRO CALC",
      "bundler": "metro",
      "output": "single",
      "themeColor": "#05070D"
    },
    "experiments": {
      "baseUrl": "/appaula1"
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#05070D"
          }
        }
      ]
    ]
  }
}
